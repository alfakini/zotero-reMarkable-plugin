{
  "name": "zotero-remarkable",
  "type": "module",
  "version": "0.3.0",
  "description": "Two-way sync of Zotero PDFs and annotations with reMarkable tablets",
  "config": {
    "addonName": "reMarkable Sync for Zotero",
    "addonID": "zotero-remarkable@alfakini.github.io",
    "addonRef": "zoteroremarkable",
    "addonInstance": "ZoteroReMarkable",
    "prefsPrefix": "extensions.zotero.zoteroremarkable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfakini/zotero-reMarkable-plugin.git"
  },
  "author": "Alan Fachini",
  "bugs": {
    "url": "https://github.com/alfakini/zotero-reMarkable-plugin/issues"
  },
  "homepage": "https://github.com/alfakini/zotero-reMarkable-plugin#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "release": "zotero-plugin release"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  }
}
