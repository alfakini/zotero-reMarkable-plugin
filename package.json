{
  "name": "zotero-remarkable",
  "type": "module",
  "version": "0.1.2",
  "description": "Two-way sync of Zotero PDFs and annotations with reMarkable tablets",
  "config": {
    "addonName": "reMarkable Sync for Zotero",
    "addonID": "zotero-remarkable@alfakini.github.io",
    "addonRef": "zoteroremarkable",
    "addonInstance": "ZoteroReMarkable",
    "prefsPrefix": "extensions.zotero.zoteroremarkable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfakini/zotero-remarkable.git"
  },
  "author": "Alan Fachini",
  "bugs": {
    "url": "https://github.com/alfakini/zotero-remarkable/issues"
  },
  "homepage": "https://github.com/alfakini/zotero-remarkable#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save",
    "test:unit": "node --import tsx --test test/unit/*.test.ts"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
