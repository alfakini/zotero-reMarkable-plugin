# Used by `npm start` (Zotero with hot reload). Copy to `.env` and adjust.
# Use a separate Zotero profile so development doesn't touch your library.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_PROFILE_PATH=/path/to/a/zotero-dev-profile
# Optional: a separate data directory (defaults to the profile's).
ZOTERO_PLUGIN_DATA_DIR=
